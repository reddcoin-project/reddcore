# Copy to .env and edit before running `docker compose up`.
#
# These override the defaults in docker-compose.yml. The examples here
# are the defaults — uncomment and change only what differs in your
# environment.

# Host-side ports for the two APIs (the only services exposed to the
# host by default). Pick something else if 3000/3232 are taken.
# BITCORE_NODE_PORT=3000
# BWS_PORT=3232
